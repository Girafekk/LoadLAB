# HTTPS-прокси для репетиции production.
# Сертификат выпускает встроенный центр сертификации Caddy: браузер ему
# не доверяет, поэтому при проверке нужно принять предупреждение или
# игнорировать ошибку сертификата в инструменте автоматизации.

https://localhost:8443 {
	tls internal
	encode gzip

	# API уходит в контейнер backend, остальное — на frontend компьютера.
	handle /api/* {
		reverse_proxy backend-prod:8000
	}

	handle {
		reverse_proxy frontend-prod:3000
	}
}
