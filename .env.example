# ─────────────────────────────────────────────────────────────────────────
# Пример настроек LoadLab.
#
# 1. Скопируйте этот файл и назовите копию `.env` (в этой же папке).
# 2. Замените POSTGRES_PASSWORD на собственный пароль.
#
# Файл `.env` содержит секреты и НЕ попадает в Git. Этот файл-пример — попадает,
# поэтому настоящие пароли сюда писать нельзя.
# ─────────────────────────────────────────────────────────────────────────

# --- Backend ---
# development — разработка, test — тесты, production — боевой сервер
ENVIRONMENT=development
# Адреса frontend, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:3000
# Порт backend на вашем компьютере. 8001, а не привычный 8000:
# на Windows порт 8000 нередко занят системными службами.
BACKEND_PORT=8001

# --- AI Teacher / DeepSeek ---
# Ключ DeepSeek хранится только здесь. Без него AI Teacher работает локально.
# DEEPSEEK_API_KEY=замените-на-ключ
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Универсальный OpenAI-совместимый резерв (если DeepSeek не задан).
# AI_TEACHER_BASE_URL=https://api.example.com/v1
# AI_TEACHER_API_KEY=замените-на-ключ
# AI_TEACHER_MODEL=model-name
# AI_TEACHER_ALLOWED_HOSTS=api.example.com

# Куда backend складывает загруженные материалы собеседований.
# INTERVIEW_UPLOAD_DIR=uploads/interview

# --- База данных PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=loadlab
POSTGRES_USER=loadlab
POSTGRES_PASSWORD=замените-на-свой-пароль

# --- Репетиция production (infrastructure/docker-compose.prod.yml) ---
# Отдельная база и отдельный пароль: с разработкой не пересекаются.
PROD_POSTGRES_DB=loadlab_prod
PROD_POSTGRES_PASSWORD=замените-на-другой-пароль
PROD_POSTGRES_PORT=15433
PROD_BACKEND_PORT=18000
# Адрес, по которому браузер видит HTTPS-прокси Caddy.
PROD_PUBLIC_URL=https://localhost:8443
PROD_CORS_ORIGINS=https://localhost:8443
# Для боевого домена: SITE_ADDRESS=loadlab.example.com и
# CADDYFILE=./Caddyfile.prod (Let's Encrypt вместо tls internal).
SITE_ADDRESS=localhost:8443
CADDYFILE=./Caddyfile
# Публичный ключ GPG для шифрования дампов; без него backup пишет открытый файл.
BACKUP_GPG_RECIPIENT=
# Имя cookie сессии production-стенда. Обязательно отличается от разработки:
# cookie не разделяются по портам, и два стенда на localhost иначе затирали бы
# cookie друг друга.
PROD_SESSION_COOKIE_NAME=loadlab_session_prod
